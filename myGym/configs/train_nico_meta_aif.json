{
    // ---------------- Environment ----------------
    "env_name"  : "Gym-v0",            // Gymnasium env ID
    "workspace" : "table_nico",        // Workspace layout/preset name
    "engine"    : "pybullet",          // Physics engine
    "render"    : "opengl",            // Render backend
    "seed"      : 1,                   // RNG seed
    "camera"    : 0,                   // Camera index / viewpoint
    "gui"       : 0,                   // 1 enables simulator GUI
    "visualize" : 0,                   // 1 enables additional visualizations
    "visgym"    : 0,                   // 1 enables VisGym suppor
    // ---------------- Robot ----------------
    "robot"         : "nico_grasp",          // Robot model name
    "robot_action"  : "joints_gripper",      // Action representation
    "robot_init"    : [0.5, 0.2, 0.4],       // Initial EE pose (xyz)
    "max_velocity"  : 3,                     // Joint/EE velocity limit
    "max_force"     : 200,                   // Force/torque limit
    "action_repeat" : 2,                     // Repeat each action this many steps

    // ---------------- Task ----------------
    "task_type"        : "A",                // Scenario/task identifier
    "natural_language" : 0,                  // 1 enables NL instructions
    "task_objects"     : [                   // Objects and goal sampling
        {
            "init": {"obj_name": "null"},
            "goal": {
                "obj_name": "towertarget",
                "fixed": 1,
                "rand_rot": 0,
                "sampling_area": [0.1, 0.4, 0.25, 0.45, 0.1, 0.3]
            }
        }
    ],
    "color_dict"   : {"apple": ["green"], "target": ["gray"]}, // Object color hints
    "used_objects" : {"num_range": [0, 0], "obj_list": []},    // Additional object config

    // Observation layout: actual_state -> obj_xyz; goal_state -> obj_xyz; extra endeff_xyz
    // actual_state = endeffector, goal_state = target, 
    "observation" : {
        "actual_state": "obj_xyz",
        "goal_state": "obj_xyz",
        "additional_obs": ["endeff_xyz"]
    },

    // ---------------- Distractors ----------------
    "distractors" : {
        "list": null,                   // Optional distractor list
        "moveable": 0,                  // 1 if distractors move
        "constant_speed": 0,            // 1 for constant-speed motion
        "movement_dims": 3,             // Number of movement dimensions
        "movement_endpoints": [-0.3, 0.3, 0.4, 0.7, 0.1, 0.3] // Min/max per axis
    },

    // ---------------- Reward/Perception ----------------
    "distance_type" : "euclidean",      // Distance metric for eval logging
    "vae_path"      : null,             // Optional VAE weights path
    "yolact_path"   : null,             // Optional YOLACT weights path
    "yolact_config" : null,             // Optional YOLACT config path

    // ---------------- Training loop ----------------
    "train_framework"   : "pytorch",    // Backend framework
    "algo"              : "meta_aif",   // Algorithm identifier
    "max_episode_steps" : 512,          // Env horizon
    "steps"             : 1000000,      // Total training timesteps
    "pretrained_model"  : null,         // Optional checkpoint path
    "multiprocessing"   : null,         // Optional multiprocessing config

    // ---------------- Active inference (AIF) ----------------
    "aif_initial_random_steps"      : 0,        // Steps of random actions before learning
    "aif_meta_recompute_freq"       : 512,      // Meta-controller recompute frequency (steps)
    "aif_model_update_freq"         : "meta_update",  // World-model update frequency: number (steps) or "meta_update" (before each meta recompute)
    "aif_model_train_epochs"        : 15,      // Number of epochs to train world model per update (like PETS)
    "aif_policy_updates_per_step"   : 1,       // Policy updates per model update
    "aif_batch_size"                : 64,      // Replay batch size
    "aif_model_lr"                  : 0.0001,  // World-model learning rate (PETS-like)
    "aif_model_wd"                  : 0.01,    // World-model weight decay (PETS-like)
    "aif_logvar_reg_weight"         : 0.0,     // Logvar bounds regularizer weight (PETS-like)
    "aif_info_gain_weight"          : 0.1,     // Weight on info gain term in EFE
    "aif_replay_size"               : 100000,  // Replay buffer capacity
    "aif_gamma"                     : 1,       // Discount factor
    "aif_device"                    : "cpu",   // Torch device
    "aif_log_freq"                  : 0,       // Logging frequency (steps) - 0 to disable
    "aif_log_vfe_terms"             : false,   // Log variational free energy terms
    "aif_log_efe_terms"             : true,    // Log expected free energy terms
    "aif_plan_recompute_freq"       : 1,       // Replanning frequency (steps)
    "aif_policy_mode"               : "policy_net",  // "cem"/"icem" use mbrl optimizers; "policy_net" uses amortized MPC; "simple_cem" uses legacy CEM
    "aif_policy_eval_mode"          : "plan",  // "plan" uses planning; "mean" uses policy_net mean (policy_net mode only)
    "fully_observable_mdp"          : true,    // Legacy flag; prefer aif_world_model.type
    "aif_drop_goal_from_state"      : false,   // Remove goal slice from the model state (goal used only for preferences)
    "aif_pref_mean"                 : null,    // Fixed preference mean (or null to use goal each step)
    "aif_pref_std"                  : 0.5,     // Preference std (scalar or per-dim)
    "aif_preference_mode"           : "gaussian",// "gaussian" (default) or "linear" distance-based
    "aif_preference_linear_scale"   : 0.0,     // Scaling factor for linear distance preference: reward = -scale * distance
    "aif_pref_target_weight"        : 0.0,     // Extra weight for sharp target prior (0 disables)
    "aif_pref_target_scale"         : 0.0,     // Std scale for sharp target component (<1 tighter)
    "aif_policy_imagination_freq"   : 0,       // Frequency of imagined rollouts for policy
    "aif_policy_imagination_updates": 0,       // Number of imagined updates per trigger
    "aif_policy_imagination_horizon": 0,       // Horizon for imagined rollouts
    "aif_policy_real_efe_freq"      : 1,       // Frequency of real-transition EFE policy updates (0 disables)
    "aif_policy_real_efe_updates"   : 1,       // Number of real-transition updates (fallback to freq if null)
    "aif_policy_elite_temperature"  : 0.5,     // Softmax temperature for elite weights (0 = uniform)
    "aif_policy_net_update_steps"   : 1,       // Gradient steps per planning call
    "aif_progress_bar"              : false,   // Show episode progress bars
    "aif_policy_net_recompute_freq" : 2,       // MPC recompute frequency (steps)
    "aif_policy_kl_beta"            : 0.1,     // KL weight for Bayesian policy
    "aif_policy_posterior_mc_samples": 3,      // MC samples over policy posterior for distillation
    "aif_policy_efe_baseline_momentum": 0.9,   // EMA momentum for EFE baseline in single-sample updates
    "aif_policy_plan_action_rollouts":  3,     // Action-noise rollouts per policy sample when planning
    // ---------------- Meta-AIF controller ----------------
    "aif_meta_debug"              : true,
    "aif_meta_enabled"            : true,      // Enable meta-planning controller
    "aif_meta_selection"          : "greedy",  // "greedy" or "softmax"
    "aif_meta_softmax_temp"       : 0.15,      // Softmax temperature for mode selection
    "aif_meta_allow_deterministic": true,      // Allow deterministic (below-min) mode
    "aif_meta_modes"              : null,      // Leave null to use min/max grid
    // Mode grid ranges
    "aif_meta_horizon_min"        : 2,
    "aif_meta_horizon_max"        : 10,
    "aif_meta_horizon_step"       : 2,
    "aif_meta_candidates_min"     : 10,
    "aif_meta_candidates_max"     : 90,
    "aif_meta_candidates_step"    : 20,
    "aif_meta_mc_models_min"      : 1,
    "aif_meta_mc_models_max"      : 3,
    "aif_meta_mc_models_step"     : 1,
    "aif_meta_mc_trajectories_min": 2,
    "aif_meta_mc_trajectories_max": 10,
    "aif_meta_mc_trajectories_step": 2,
    "aif_meta_action_rollouts_min": 1,
    "aif_meta_action_rollouts_max": 5,
    "aif_meta_action_rollouts_step": 1,
    // EFE weights: G = Ambiguity + Risk
    // Ambiguity = E_Q(θ)[H(P(o|θ, mode))] - uncertainty about outcomes
    // Risk = KL[q(o|mode) || p(o|C)] - divergence from preferred observations
    "aif_meta_cost_log"                : true, // Use log(1+cost) for complexity normalization
    "aif_meta_policy_ambiguity_weight" : 6,    // Weight on ambiguity term (entropy of likelihood)
    "aif_meta_model_ambiguity_weight"  : 1,    // Scales likelihood sharpness via model_uncert

    // Observation preference precisions (higher = stronger preference)
    // Risk = KL[q(o|mode) || p(o|C)] where p(o|C) ~ N(μ_pref, 1/precision)
    "aif_meta_pref_extrinsic_precision"  : 1,  // Precision for extrinsic_value preference
    "aif_meta_pref_effort_precision"     : 1,  // Precision for effort preference
    // Observation preference means (target values for each observation dimension)
    "aif_meta_pref_extrinsic_mean"       : 0.9,  // Prefer high extrinsic value (goal achievement)
    "aif_meta_pref_effort_mean"          : 0.0,  // Prefer low effort (computational efficiency)
    "aif_meta_capacity_exponent"         : 0.6,  // Exponent on normalized capacity (<1 compresses, >1 amplifies)
    "aif_meta_extrinsic_value_weight"    : 0.5,  // Weight on extrinsic value in composite θ (0 = policy uncert only)
    "aif_meta_risk_include_variance"     : true, // Include τ·σ² variance term in risk (full KL divergence)
    // EMA betas for feature tracking
    "aif_meta_error_ema_beta"     : 0.8,
    "aif_meta_uncert_ema_beta"    : 0.8,
    "aif_meta_policy_uncert_ema_beta"    : 0.995,
    "aif_meta_extrinsic_value_ema_beta"  : 0.995,
    // Uncertainty estimation
    "aif_meta_uncertainty_probe_actions" : 4,
    "aif_meta_uncertainty_action_noise"  : 0.2,
    "aif_meta_policy_uncertainty_samples": 4,
    "aif_meta_variance_exponent"         : 2, // Exponent on variance term in risk computation
    "aif_meta_planning_variance_reduction_factor": 0.8, // Factor for planning variance reduction (0-1)
    "aif_meta_planning_noise_factor"             : 1.0, // Noise scaling from model unreliability
    // Initial EMA values
    "aif_meta_initial_model_error"   : 1.0,
    "aif_meta_initial_model_uncert"  : 1.0,
    "aif_meta_initial_policy_uncert" : 1.0,
    "aif_meta_initial_extrinsic_value": 0.0,   // Initial extrinsic value (0 = neutral)
    "aif_meta_warmup_transitions"    : 0,
    "aif_world_model"               : {        // World-model settings
        "type": "pets",                        // "vae" (default), "bayesian", or "pets"
        "ensemble_size": 3,                    // Number of dynamics ensemble members
        "hid_size": 64                         // Hidden size for dynamics nets
    },
    "aif_model_normalize"       : true,        // Normalize inputs for fully observable PETS/Bayesian dynamics
    "aif_tensorboard_log"       : true,        // Log AIF metrics to TensorBoard (logdir/aif_tb)
    "aif_deterministic"         : false,       // Use deterministic dynamics model    
    "aif_use_mse_loss"          : false,       // If true, use MSE loss; if false, use Gaussian NLL loss    
    "aif_loss_weight_kl_state"  : 1.0,         // Weight on KL divergence between encoder and dynamics
    "aif_loss_weight_nll_obs"   : 1.0,         // Weight on observation reconstruction loss
    "aif_kl_theta_beta"         : 0.001,         // KL weight for prior over dynamics (acts as regularizer)
    "aif_info_gain_mode"        : "ensemble_var",// "logvar", "ensemble_var", or "both" info gain mode
    
    "aif_icem_population_decay_factor"  :1.1,
    "aif_icem_keep_elite_frac"          :0.2,   
    "aif_icem_colored_noise_exponent"   :2.0,
    "aif_icem_alpha"                    :0.25,
    "aif_icem_return_mean_elites"       :true,
    "aif_cem_clipped_normal"        :true,      // Use clipped normal distribution in CEM/ICEM 


    // ---------------- Evaluation ----------------
    "eval_freq"     : 15000,            // Evaluation interval (steps)
    "eval_episodes" : 10,               // Episodes per evaluation

    // ---------------- Saving & logging ----------------
    "record"    : 0                    // 1 to record rollouts
}
